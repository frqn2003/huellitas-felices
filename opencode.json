{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".agents/skills", ".opencode/skills"]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "environment": { "BROWSER": "chromium" }
    }
  },
  "permission": {
    "bash": {
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "*": "ask"
    }
  }
}
