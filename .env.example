# Copiar a .env.local y ajustar. .env.local NO se commitea.

# ---------------------------------------------------------
# BASE DE DATOS
# ---------------------------------------------------------
# Postgres local (docker-compose.yml):
# DATABASE_URL=postgresql://huellitas:local@localhost:5432/huellitas_felices

# Supabase — usar el SESSION POOLER (host pooler.supabase.com, puerto 5432).
# Es IPv4; la "direct connection" (db.<ref>.supabase.co) es IPv6 only y falla
# en redes IPv4. La password es la de la BASE, no la de tu cuenta:
# Project Settings -> Database -> Database password.
#
# OJO 1 · sslmode=no-verify, no `require`.
#   Con `require` Node verifica el certificado contra las CA del sistema y
#   Supabase falla con: Error: self-signed certificate in certificate chain
#   (SELF_SIGNED_CERT_IN_CHAIN). Con `no-verify` la conexion SIGUE ENCRIPTADA,
#   solo no se valida la identidad del servidor. Alcanza para desarrollo.
#   Para verificar de verdad: Project Settings -> Database -> SSL Configuration
#   -> descargar el certificado y pasarlo por ssl.ca en src/lib/db/client.ts.
#
# OJO 2 · si la password tiene caracteres especiales, hay que percent-encodearlos:
#   @ -> %40   # -> %23   / -> %2F   : -> %3A   % -> %25
#   El @ es el peor: parte la URI y el error parece de host, no de password.
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=no-verify

# ---------------------------------------------------------
# SESION Y LOGIN (HU-SIS-04)
# ---------------------------------------------------------
# Secreto con el que se FIRMA la cookie de sesion. Sin esto el login no arranca.
#
# No es decorativo: la cookie lleva el id del usuario, y sin firma cambiar
# {"uid":4} por {"uid":1} en el navegador es hacerse administrador.
#
# Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Si cambia, todas las sesiones abiertas dejan de valer (es lo esperado).
SESSION_SECRET=cambiar-en-produccion-string-largo-y-aleatorio

# Supabase Auth — es donde vive la contraseña.
#
# La tabla `usuario` NO tiene password: tiene `auth_id uuid` que apunta a
# `auth.users` de Supabase. El backend le pregunta a Supabase si la contraseña
# es correcta (src/lib/auth/gotrue.ts).
#
# Los dos valores salen de: Supabase -> Project Settings -> API
#   SUPABASE_URL      = "Project URL"
#   SUPABASE_ANON_KEY = "anon public"  <- la publica, NO la service_role
#
# La anon key esta pensada para ir en clientes web, asi que no es un secreto.
# La que nunca se pone aca es la `service_role`: esa saltea todas las politicas
# de seguridad de la base.
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_ANON_KEY=[anon public key]

# Para que un empleado pueda entrar, tiene que existir en DOS lugares:
#   1. Supabase -> Authentication -> Users  (ahi se le pone la contraseña)
#   2. la tabla `usuario`, con `auth_id` = el uuid del paso 1
# El trigger `handle_new_user()` hace el paso 2 automaticamente cuando el
# usuario se crea desde Supabase Auth con los metadatos correctos.

# ---------------------------------------------------------
# ATAJO DE DESARROLLO — sacar para probar el login
# ---------------------------------------------------------
# Mientras esta linea exista, TODAS las requests operan como este usuario sin
# pasar por el login, y `requireSession()` nunca devuelve 401.
#
# Sirve para probar el resto del sistema sin loguearse. Pero OJO:
#
#   ⚠️ CON ESTO PUESTO, EL LOGIN "NO HACE NADA": el front nunca recibe un 401,
#      asi que nunca redirige a /login. No es un bug, es esta variable.
#      Para probar HU-SIS-04, COMENTAR O BORRAR esta linea.
#
# Tiene que coincidir con un `usuario.dni` activo (ver db/seeds/02_demo.sql).
SESSION_USUARIO_DNI=30111222
